{
  "name": "frikanalen",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prettier": "prettier",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "build": "orval && next build",
    "start": "next start",
    "fetch-api": "wget -nv http://localhost:8000/api/schema/ -O django-api.yaml && npx -y openapi-format django-api.yaml -o django-api.yaml && rm -rf src/generated/* && orval",
    "orval": "rm -rf src/generated/* && orval",
    "lint": "eslint .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@hookform/resolvers": "^5.9.0",
    "@internationalized/date": "^3.12.4",
    "@mdxeditor/editor": "^4.5.0",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-query": "^5.107.1",
    "@vidstack/react": "^1.15.7",
    "axios": "^1.21.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dashjs": "^4.7.4",
    "date-fns": "^4.4.0",
    "markdown-to-jsx": "^9.10.6",
    "media-icons": "^1.1.5",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "react-use": "^17.6.1",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
