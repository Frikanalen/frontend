{
  "name": "frikanalen",
  "version": "2.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prettier": "prettier",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "build": "orval && next build",
    "start": "next start",
    "fetch-api": "wget -nv http://localhost:8000/api/schema/ -O django-api.yaml && npx -y openapi-format django-api.yaml -o django-api.yaml && rm -rf src/generated/* && orval",
    "orval": "rm -rf src/generated/* && orval",
    "lint": "eslint .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "@hookform/resolvers": "^5.9.0",
    "@mdxeditor/editor": "^4.2.0",
    "@tanstack/react-query": "^5.101.4",
    "@vidstack/react": "^1.12.13",
    "axios": "^1.19.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dashjs": "^4.7.4",
    "date-fns": "^4.4.0",
    "framer-motion": "12.23.12",
    "markdown-to-jsx": "^9.10.2",
    "media-icons": "^1.1.5",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "react-use": "^17.6.1",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.1",
    "happy-dom": "^20.11.2",
    "msw": "^2.15.0",
    "orval": "^8.24.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
