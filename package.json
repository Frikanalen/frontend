    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^20.14.6",
    "msw": "^2.15.0",
    "orval": "^8.47.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
